# APP_URL=https://YOUR_USERNAME.github.io/Weekly-Vehicle-Checklist/
# Supabase supplies SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY to Edge Functions.
# Bootstrap CLI only (set in your private shell; never commit values):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# ADMIN_EMAIL=YOUR_ADMIN_EMAIL
# ADMIN_NAME=YOUR_ADMIN_NAME
# APP_URL=https://YOUR_USERNAME.github.io/Weekly-Vehicle-Checklist/
